{
  "schemaVersion": 1,
  "systemId": "sistemafinanceiro",
  "mode": "electron",
  "defaultEnvironment": "final",
  "defaultFlow": "final-screens",
  "defaultViewport": "desktop",
  "capture": {
    "video": false,
    "screenshotEachStep": false,
    "fps": 4
  },
  "electron": {
    "entry": "electron/main.cjs",
    "executablePath": "node_modules/electron/dist/electron.exe"
  },
  "environments": {
    "final": {
      "startCommand": "npm run dev",
      "readyUrl": "http://127.0.0.1:5173",
      "readyTimeoutMs": 60000,
      "env": {
        "ARTISYS_QA": "1",
        "ARTISYS_QA_RESET": "1",
        "VITE_DEV_SERVER_URL": "http://127.0.0.1:5173"
      }
    }
  },
  "flows": {
    "bootstrap-smoke": "qa/flows/bootstrap-smoke.json",
    "final-screens": "qa/flows/final-screens.json"
  },
  "demos": {}
}
