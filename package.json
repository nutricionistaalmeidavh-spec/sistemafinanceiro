{
  "name": "artisys-sistema-financeiro",
  "version": "0.1.1",
  "private": true,
  "description": "Sistema financeiro desktop local-first da ArtiSys",
  "author": "ArtiSys",
  "main": "electron/main.cjs",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "electron:dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "test": "node --test tests/*.test.mjs",
    "build": "tsc --noEmit && vite build",
    "check": "npm test && npm run build",
    "dist": "npm run build && npm run dist:package",
    "dist:package": "npm run ocr:stage && node ./scripts/package-windows.mjs",
    "qa:validate": "artisys-qa validate --config ./artisys-qa.config.json",
    "qa:final": "node ./scripts/qa-final-local.mjs",
    "ci:bootstrap": "node ./scripts/ci-bootstrap.mjs && node ./scripts/ci-bootstrap-ocr.mjs",
    "ci:qa-final": "node ./scripts/ci-capture-final-screens.mjs",
    "security": "node ./scripts/security.mjs",
    "release:check": "node ./scripts/release-check.mjs",
    "artifacts:local": "npm test && npm run build && npm run dist:package && npm run qa:final",
    "final:prepare": "node ./scripts/final-gates.mjs",
    "final:release": "npm run final:prepare && npm run qa:final && npm run dist:package",
    "ocr:stage": "node ./scripts/stage-ocr-assets.mjs"
  },
  "dependencies": {
    "@artisys/dashboard": "file:vendor/utilidades/modules/artisys-dashboard",
    "@artisys/desktop-shell": "file:vendor/utilidades/modules/artisys-desktop-shell",
    "@artisys/eventbus": "file:vendor/utilidades/modules/artisys-eventbus",
    "@artisys/finance-domain": "file:vendor/utilidades/modules/artisys-finance-domain",
    "@artisys/ocr": "file:vendor/utilidades/modules/artisys-ocr",
    "@artisys/pdf": "file:vendor/utilidades/modules/artisys-pdf",
    "@artisys/printing": "file:vendor/utilidades/modules/artisys-printing",
    "@artisys/storage": "file:vendor/utilidades/modules/artisys-storage",
    "@napi-rs/canvas": "1.0.9",
    "@tesseract.js-data/por": "1.0.0",
    "docx": "9.15.3",
    "echarts": "6.1.0",
    "exceljs": "4.4.0",
    "lucide-react": "1.28.0",
    "papaparse": "5.7.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.3.289",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "concurrently": "10.0.4",
    "cross-env": "10.1.0",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "wait-on": "9.1.0",
    "@artisys/qa": "file:vendor/utilidades/modules/artisys-qa",
    "@artisys/release": "file:vendor/utilidades/modules/artisys-release",
    "playwright": "1.62.1"
  },
  "build": {
    "appId": "br.com.artisys.sistemafinanceiro",
    "productName": "ArtiSys Financeiro",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "database/**/*",
      "package.json",
      "!electron/trial-main.cjs",
      "!electron/trial-preload.cjs",
      "!electron/services/trial-public.pem",
      "!electron/services/trial-activation.bundle.json",
      "!electron/services/license-service.cjs"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "ArtiSys-Financeiro-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "extraResources": [
      {
        "from": "resources/ocr-data",
        "to": "ocr-data",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
