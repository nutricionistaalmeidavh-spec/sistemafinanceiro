{
  "name": "artisys-sistema-financeiro",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema financeiro desktop local-first da ArtiSys",
  "author": "ArtiSys",
  "main": "electron/main.cjs",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "electron:dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "test": "node --test tests/*.test.mjs",
    "build": "tsc --noEmit && vite build",
    "check": "npm test && npm run build",
    "dist": "npm run build && electron-builder --win nsis --x64 --publish never",
    "dist:package": "electron-builder --win nsis --x64 --publish never",
    "qa:validate": "artisys-qa validate --config ./artisys-qa.config.json",
    "qa:final": "artisys-qa run --config ./artisys-qa.config.json --environment final --viewport desktop --flow final-screens --output qa-artifacts/final",
    "ci:bootstrap": "node ./scripts/ci-bootstrap.mjs",
    "ci:qa-final": "node ./scripts/ci-capture-final-screens.mjs",
    "security": "node ./scripts/security.mjs",
    "release:check": "node ./scripts/release-check.mjs",
    "final:prepare": "node ./scripts/final-gates.mjs",
    "final:release": "npm run final:prepare && npm run qa:final && npm run dist:package"
  },
  "dependencies": {
    "better-sqlite3": "13.0.2",
    "lucide-react": "1.28.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "pdfjs-dist": "6.3.289",
    "@artisys/desktop-shell": "file:vendor/utilidades/modules/artisys-desktop-shell",
    "@artisys/eventbus": "file:vendor/utilidades/modules/artisys-eventbus",
    "@artisys/dashboard": "file:vendor/utilidades/modules/artisys-dashboard",
    "@artisys/finance-domain": "file:vendor/utilidades/modules/artisys-finance-domain",
    "@artisys/pdf": "file:vendor/utilidades/modules/artisys-pdf",
    "@artisys/printing": "file:vendor/utilidades/modules/artisys-printing"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "concurrently": "10.0.4",
    "cross-env": "10.1.0",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "wait-on": "9.1.0",
    "@artisys/qa": "file:vendor/utilidades/modules/artisys-qa",
    "@artisys/release": "file:vendor/utilidades/modules/artisys-release",
    "playwright": "1.62.1"
  },
  "build": {
    "appId": "br.com.artisys.sistemafinanceiro",
    "productName": "ArtiSys Financeiro",
    "npmRebuild": false,
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "database/**/*", "package.json"],
    "asarUnpack": ["node_modules/better-sqlite3/**/*"],
    "win": { "target": ["nsis"], "artifactName": "ArtiSys-Financeiro-Setup-${version}.${ext}" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true }
  }
}
