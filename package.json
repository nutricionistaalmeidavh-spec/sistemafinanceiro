{
  "name": "artisys-sistema-financeiro",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema financeiro desktop local-first da ArtiSys",
  "main": "electron/main.cjs",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "electron:dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "test": "node --test tests/*.test.mjs",
    "build": "tsc --noEmit && vite build",
    "check": "npm test && npm run build",
    "dist": "npm run build && electron-builder --win nsis --x64",
    "qa:validate": "artisys-qa validate --config ./artisys-qa.config.json",
    "security": "node ./scripts/security.mjs",
    "release:check": "node ./scripts/release-check.mjs"
  },
  "dependencies": {
    "better-sqlite3": "13.0.2",
    "lucide-react": "1.28.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@artisys/desktop-shell": "file:vendor/utilidades/modules/artisys-desktop-shell",
    "@artisys/eventbus": "file:vendor/utilidades/modules/artisys-eventbus",
    "@artisys/dashboard": "file:vendor/utilidades/modules/artisys-dashboard",
    "@artisys/pdf": "file:vendor/utilidades/modules/artisys-pdf"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "concurrently": "10.0.4",
    "cross-env": "10.1.0",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "wait-on": "9.1.0",
    "@artisys/qa": "file:vendor/utilidades/modules/artisys-qa",
    "@artisys/release": "file:vendor/utilidades/modules/artisys-release",
    "playwright": "1.62.1"
  },
  "build": {
    "appId": "br.com.artisys.sistemafinanceiro",
    "productName": "ArtiSys Financeiro",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "database/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "win": {
      "target": ["nsis"],
      "artifactName": "ArtiSys-Financeiro-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
